# ── Analytics ─────────────────────────────────────────────────
# Vercel Web Analytics needs no keys (just enable it on the project).
#
# PostHog (richer dashboard, session replay) is optional. Without these
# keys the site still runs; PostHog just stays off. Get them from
# PostHog → Project Settings → Project API Key.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
